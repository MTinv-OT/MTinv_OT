    "inv.plot_model_comparison(\n",
    "    cmap=\"jet_r\",\n",
    "    clip_to_stations=True,\n",
    "    ylim=[50, 0],\n",
    "    vmin=1,\n",
    "    vmax=3,\n",
    "    synthetic_figwidth_scale=2.0,\n",
    ")\n",
    "inv.plot_data_fitting()\n",
    "inv.plot_1d_profiles(depth_limit_km=50)\n",
    "inv.plot_gradient_history()"
   ]
