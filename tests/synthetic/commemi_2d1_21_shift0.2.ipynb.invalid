   "source": [
    "# 6a) 保存 OT 结果\n",
    "ot_run_dir = logger.save_from_inverter(inv, run_name=\"ot_21_1shift0.2\")\n",
    "history_ot = list(inv.loss_history)\n",
    "print(f\"OT run saved: {ot_run_dir}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdd8c61e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4b) MSE 反演（同一静位移观测数据，重置初模）\n",
    "inv.initialize_model(initial_sigma=0.01)\n",
    "final_sigma_mse = inv.run_inversion(\n",
    "    n_epochs=300,\n",
    "    mode=\"mse\",\n",
    "    progress_interval=20,\n",
    "    current_lambda=0.01,\n",
    "    use_adaptive_lambda=True,\n",
    "    lr=0.03,\n",
    "    update_interval=10,\n",
    "    norm_type=\"L2\",\n",
    "    alpha=0.5,\n",
    "    use_depth_weights=True,\n",
    "    rms_chi2_stop=1.05,\n",
    "    profile_timing=False,\n",
    ")\n",
    "print(\"MSE inversion done\")\n",
    "print(final_sigma_mse.min().item(), final_sigma_mse.max().item())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5d172662",
   "metadata": {},
   "outputs": [],
