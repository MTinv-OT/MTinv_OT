   ],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "print(f\"当前目录: {Path.cwd()}\")\n",
    "print(f\"目录内容: {list(Path.cwd().iterdir())}\")\n",
    "\n",
    "# 检查 src 在哪里\n",
    "for p in [Path.cwd(), Path.cwd().parent, Path.cwd().parent.parent]:\n",
    "    if (p / \"src\").exists():\n",
    "        print(f\"找到 src 在: {p}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b1d8f33a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Grid (nz, ny): (40, 40)\n",
      "Stations: 21, Freqs: 30\n"
     ]
    }
   ],
   "source": [
    "# 1) Build COMMEMI 2D-i true model\n",
    "yn, zn, nza, sig_true = MT2DTrueModels.create_commemi_2d4(\n",
    "    nza=10,\n",
    "    device=device, \n",
    ")\n",
    "\n",
    "# 2) Survey setup\n",
    "freqs = torch.logspace(0, -5, 30, device=device)\n",
    "stations = torch.linspace(-15000.0, 15000.0, 21, device=device)\n",
    "\n",
    "print(f\"Grid (nz, ny): {(len(zn)-1, len(yn)-1)}\")\n",
    "print(f\"Stations: {len(stations)}, Freqs: {len(freqs)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "769f327e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Random seed set: 123\n",
      "✓ Sinkhorn (custom cost): blur=0.0100, scaling=0.9\n",
      "✓ Sinkhorn OT Loss (weighted): w_s=1.0, w_f=1.0, w_d=(1.0, 1.0, 1.0, 1.0), blur=0.0100, scale=0.9, reach=None\n",
      "Generating 2D MT synthetic data...\n",
      "✓ XY mode error propagation completed\n",
